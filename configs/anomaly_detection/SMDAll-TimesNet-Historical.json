{
  "task": {"name": "AnomalyDetection"},
  "data": {
    "source": {"name": "SMDAll", "raw_path": "datasets/SMD/raw", "batch_size": 128},
    "partition": {"name": "PerFile"},
    "split": {
      "name": "HistoricalValidation",
      "window_length": 100,
      "validation_ratio": 0.2,
      "train_stride": 100
    },
    "scaler": {"name": "Standard"},
    "view": {"name": "Offline"},
    "store": {"name": "Parquet", "root": "datasets"}
  },
  "model": {
    "name": "TimesNet",
    "encoder_layers": 2,
    "k": 5,
    "d_model": 64,
    "d_ff": 64,
    "num_inception_kernels": 6,
    "dropout": 0.1
  },
  "learner": {
    "name": "Gradient",
    "epochs": 1,
    "learning_rate": 0.0001,
    "optimizer": {"name": "Adam"},
    "fused_optimizer": false
  },
  "strategy": {"name": "Centralized", "iterations": 10},
  "evaluation": {
    "name": "Calibrated",
    "anomaly_ratio": 0.5,
    "calibration": "train_test",
    "patience": 3
  },
  "runtime": {"name": "Serial", "seed": 2021},
  "scheduler": {"name": "EpochHalving", "interval": 1}
}
