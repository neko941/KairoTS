{
  "task": {"name": "Imputation", "mask_ratio": 0.25, "seed": 0},
  "data": {
    "source": {"name": "ETDatasetHour", "raw_path": "datasets/ETDataset/raw", "input_channels": ["HUFL", "HULL", "MUFL", "MULL", "LUFL", "LULL", "OT"], "batch_size": 32},
    "partition": {"name": "PerFile"},
    "split": {"name": "CompleteWindowRatio", "input_length": 0, "output_length": 96, "offset_length": 0, "cut": "shared_calendar", "lookback_crosses_boundary": false, "min_windows": 1},
    "scaler": {"name": "Standard"},
    "view": {"name": "Offline"},
    "store": {"name": "Parquet", "root": "datasets"}
  },
  "model": {"name": "TimesNet"},
  "learner": {"name": "Gradient", "learning_rate": 0.001},
  "strategy": {"name": "FedAvg", "iterations": 3},
  "evaluation": {"name": "Frozen"},
  "runtime": {"name": "Serial", "runs_dir": "runs/pretrain"}
}
