{
  "task": {"name": "AnomalyDetection"},
  "data": {
    "source": {"name": "SMDGroup1", "raw_path": "datasets/SMD/raw", "batch_size": 128},
    "partition": {"name": "PerFile"},
    "split": {"name": "Predefined", "window_length": 100, "validation_ratio": 0.2, "min_windows": 1},
    "scaler": {"name": "Standard"},
    "view": {"name": "Offline"},
    "store": {"name": "Parquet", "root": "datasets"}
  },
  "model": {"name": "DLinear"},
  "learner": {"name": "Gradient"},
  "strategy": {"name": "FedAvg", "iterations": 10},
  "evaluation": {"name": "Calibrated", "anomaly_ratio": 0.5},
  "runtime": {"name": "Serial"}
}
