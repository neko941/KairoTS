{
  "task": {
    "name": "Classification"
  },
  "data": {
    "source": {
      "name": "BasicMotions",
      "raw_path": "datasets/UEA/raw",
      "batch_size": 10
    },
    "partition": {
      "name": "Dirichlet",
      "num_clients": 2,
      "alpha": 0.5,
      "min_samples": 10,
      "seed": 0
    },
    "split": {
      "name": "Predefined",
      "seed": 0,
      "min_windows": 1,
      "validation_ratio": 0.2
    },
    "scaler": {
      "name": "Standard"
    },
    "view": {
      "name": "Offline"
    },
    "store": {
      "name": "Parquet",
      "root": "datasets"
    }
  },
  "model": {
    "name": "DLinear"
  },
  "learner": {
    "name": "Gradient",
    "learning_rate": 5e-05,
    "epochs": 3,
    "optimizer": {
      "name": "Adam"
    }
  },
  "strategy": {
    "name": "MoEFL",
    "iterations": 20,
    "specialist_epochs": 20,
    "mixture_epochs": 20
  },
  "evaluation": {
    "name": "Frozen"
  },
  "runtime": {
    "name": "Serial"
  }
}
