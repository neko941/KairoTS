{
  "task": {"name": "Forecasting", "target_channels": ["OT"], "calendar": ["HourOfDay", "DayOfWeek", "DayOfMonth", "DayOfYear"]},
  "data": {
    "source": {"name": "ETDatasetHour", "raw_path": "datasets/ETDataset/raw", "input_channels": ["HUFL", "OT"], "batch_size": 32},
    "partition": {"name": "PerFile"},
    "split": {"name": "CompleteWindowRatio", "input_length": 96, "output_length": 24, "offset_length": 0, "cut": "per_client", "lookback_crosses_boundary": false, "min_windows": 1},
    "scaler": {"name": "Standard"},
    "view": {"name": "Offline"},
    "store": {"name": "Parquet", "root": "datasets"}
  },
  "model": {"name": "TiDE"},
  "learner": {"name": "Gradient"},
  "strategy": {"name": "FedAvg"},
  "evaluation": {"name": "Frozen", "loss": "MSE", "metrics": {"test": ["MAE", "MASE"]}},
  "runtime": {"name": "Serial"}
}
