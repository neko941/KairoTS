{
  "task": {"name": "Forecasting", "target_channels": ["OT"]},
  "data": {
    "source": {"name": "ETTh1", "raw_path": "datasets/ETDataset/raw", "input_channels": ["HUFL", "HULL", "MUFL", "MULL", "LUFL", "LULL", "OT"], "batch_size": 32},
    "partition": {"name": "PerFile"},
    "split": {"name": "CompleteWindowRatio", "input_length": 96, "output_length": 24, "offset_length": 0, "cut": "per_client", "lookback_crosses_boundary": false, "min_windows": 1},
    "scaler": {"name": "Standard"},
    "view": {"name": "Offline"},
    "store": {"name": "Parquet", "root": "datasets"}
  },
  "model": {"name": "SplitNN", "party_channels": [3, 3]},
  "learner": {"name": "Gradient"},
  "strategy": {"name": "SplitNN", "iterations": 3},
  "evaluation": {"name": "Frozen", "loss": "MSE", "metrics": {"test": ["MAE", "R2"]}},
  "runtime": {"name": "Serial"}
}
