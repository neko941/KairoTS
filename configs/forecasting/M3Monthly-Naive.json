{
  "task": {"name": "Forecasting"},
  "data": {
    "source": {"name": "M3Monthly", "raw_path": "datasets/M3/raw", "batch_size": 128},
    "partition": {"name": "PerFile"},
    "split": {"name": "TestFold", "input_length": 1, "output_length": 18, "train_stride": 18, "min_windows": 1},
    "scaler": {"name": "Identity"},
    "view": {"name": "Offline"},
    "store": {"name": "Parquet", "root": "datasets"}
  },
  "model": {"name": "Naive", "output_length": 18},
  "learner": {"name": "Stateless"},
  "strategy": {"name": "LocalOnly", "iterations": 1},
  "evaluation": {"name": "Frozen", "loss": "MSE", "metrics": {"test": ["SMAPE", "MASE"]}},
  "runtime": {"name": "Serial"}
}
