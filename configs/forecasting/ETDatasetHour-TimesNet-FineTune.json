{
  "task": {"name": "Forecasting"},
  "data": {
    "source": {"name": "ETDatasetHour", "raw_path": "datasets/ETDataset/raw", "input_channels": ["HUFL", "HULL", "MUFL", "MULL", "LUFL", "LULL", "OT"], "batch_size": 32},
    "partition": {"name": "PerFile"},
    "split": {"name": "CompleteWindowRatio", "input_length": 96, "output_length": 24, "offset_length": 0, "cut": "shared_calendar", "lookback_crosses_boundary": false, "min_windows": 1},
    "scaler": {"name": "Standard"},
    "view": {"name": "Offline"},
    "store": {"name": "Parquet", "root": "datasets"}
  },
  "model": {"name": "TimesNet"},
  "learner": {"name": "Gradient"},
  "strategy": {"name": "FedAvg", "iterations": 3},
  "evaluation": {"name": "Frozen", "loss": "MSE", "metrics": {"validation": ["MAE"], "test": ["MAE", "R2"]}},
  "runtime": {"name": "Serial"},
  "initialization": {"name": "Pretrained", "run_dir": "runs/pretrain/ETDatasetHour-FedAvg-TimesNet"}
}
