{
  "reproduces": {
    "paper": "arXiv:2310.06625v4",
    "code": "https://github.com/thuml/iTransformer/tree/c2426e68ca13f74aaec08045c5c724d8ad328124"
  },
  "task": {
    "name": "Forecasting",
    "calendar": ["HourOfDay", "DayOfWeek", "DayOfMonth", "DayOfYear"]
  },
  "data": {
    "source": {
      "name": "Electricity",
      "batch_size": 16
    },
    "partition": {
      "name": "PerFile"
    },
    "split": {
      "name": "CompleteWindowRatio",
      "input_length": 96,
      "offset_length": 0,
      "cut": "per_client",
      "lookback_crosses_boundary": true,
      "min_windows": 1,
      "cut_rows": [18412, 21044, 26304]
    },
    "scaler": {
      "name": "Standard"
    },
    "view": {
      "name": "Offline",
      "drop_last": true
    },
    "store": {
      "name": "Parquet",
      "root": "datasets"
    }
  },
  "model": {
    "name": "iTransformer",
    "encoder_layers": 3,
    "d_model": 512,
    "d_ff": 512,
    "attention_heads": 8,
    "dropout": 0.1,
    "use_normalization": true,
    "calendar_channels": 4
  },
  "learner": {
    "name": "Gradient",
    "epochs": 1,
    "learning_rate": 0.0005,
    "optimizer": {
      "name": "Adam"
    }
  },
  "strategy": {
    "name": "Centralized",
    "iterations": 10
  },
  "evaluation": {
    "name": "Frozen",
    "loss": "MSE",
    "patience": 3,
    "metrics": {
      "validation": ["MSE"],
      "test": ["MSE"]
    }
  },
  "runtime": {
    "name": "Serial",
    "seed": 2023
  },
  "scheduler": {
    "name": "EpochHalving",
    "interval": 1
  },
  "sweep": {
    "data.split.output_length": [96, 192, 336, 720]
  }
}
