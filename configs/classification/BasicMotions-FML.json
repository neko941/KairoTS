{
  "task": {"name": "Classification"},
  "data": {
    "source": {"name": "BasicMotions", "raw_path": "datasets/UEA/raw", "batch_size": 16},
    "partition": {"name": "IID", "num_clients": 4, "seed": 0},
    "split": {"name": "Predefined", "seed": 0, "min_windows": 1},
    "scaler": {"name": "Standard"},
    "view": {"name": "Offline"},
    "store": {"name": "Parquet", "root": "datasets"}
  },
  "model": {"name": "DLinear"},
  "learner": {"name": "Gradient", "learning_rate": 0.01},
  "strategy": {"name": "FML", "iterations": 20},
  "groups": [
    {
      "clients": [0, 1],
      "client_model": {
        "name": "TimesNet", "d_model": 4, "d_ff": 8,
        "encoder_layers": 1, "k": 2, "num_inception_kernels": 1
      }
    },
    {"clients": [2, 3], "client_model": {"name": "DLinear"}}
  ],
  "evaluation": {"name": "Frozen"},
  "runtime": {"name": "Serial"}
}
