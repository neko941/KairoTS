{
  "task": {"name": "Classification"},
  "data": {
    "source": {"name": "BasicMotions", "raw_path": "datasets/UEA/raw", "batch_size": 16},
    "partition": {"name": "IID", "num_clients": 2, "seed": 0},
    "split": {"name": "Predefined", "seed": 0, "min_windows": 1},
    "scaler": {"name": "Standard"},
    "view": {"name": "Offline"},
    "store": {"name": "Parquet", "root": "datasets"}
  },
  "model": {"name": "DLinear"},
  "learner": {"name": "Gradient", "learning_rate": 0.01},
  "strategy": {"name": "FedBABU", "iterations": 20},
  "evaluation": {"name": "Frozen", "finetune_epochs": 1},
  "runtime": {"name": "Serial"}
}
