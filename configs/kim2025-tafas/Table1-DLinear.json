{
  "reproduces": {
    "paper": "arXiv:2501.04970v1",
    "code": "https://github.com/kimanki/TAFAS/tree/139bf980671da4daad728a0fc21d8df508b9203d"
  },
  "task": {
    "name": "Forecasting"
  },
  "data": {
    "source": {
      "name": "ETTh1",
      "raw_path": "datasets/ETDataset/raw",
      "input_channels": ["HUFL", "HULL", "MUFL", "MULL", "LUFL", "LULL", "OT"],
      "batch_size": 64
    },
    "partition": {
      "name": "PerFile"
    },
    "split": {
      "name": "CompleteWindowRatio",
      "input_length": 96,
      "output_length": 96,
      "offset_length": 0,
      "ratios": [0.6, 0.2, 0.2],
      "cut": "per_client",
      "lookback_crosses_boundary": true,
      "min_windows": 1
    },
    "scaler": {
      "name": "Standard"
    },
    "view": {
      "name": "Offline",
      "drop_last": true
    },
    "store": {
      "name": "Parquet",
      "root": "datasets"
    }
  },
  "model": {
    "name": "DLinear",
    "moving_average_kernel": 25,
    "individual": false
  },
  "learner": {
    "name": "Gradient",
    "epochs": 1,
    "learning_rate": 0.0001,
    "optimizer": {
      "name": "Adam",
      "weight_decay": 0.0001
    }
  },
  "strategy": {
    "name": "Centralized",
    "iterations": 30
  },
  "evaluation": {
    "name": "TAFAS",
    "loss": "MSE",
    "learning_rate": 0.001,
    "gating_init": 0.01,
    "steps": 1,
    "optimizer": {
      "name": "Adam",
      "weight_decay": 0.0
    },
    "metrics": {
      "validation": ["MSE"],
      "test": ["MSE"]
    }
  },
  "runtime": {
    "name": "Serial",
    "seed": 941,
    "runs_dir": "runs/tafas"
  },
  "scheduler": {
    "name": "Cosine"
  }
}
