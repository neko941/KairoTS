{
  "reproduces": {
    "paper": "arXiv:2210.02186v3",
    "code": "https://github.com/thuml/Time-Series-Library/tree/2665a3143dae12d1cbcc31ddd396bbff48773bce"
  },
  "task": {
    "name": "Forecasting",
    "calendar": ["HourOfDay", "DayOfWeek", "DayOfMonth", "DayOfYear"]
  },
  "data": {
    "source": {
      "name": "ILI"
    },
    "partition": {
      "name": "PerFile"
    },
    "split": {
      "name": "CompleteWindowRatio",
      "input_length": 36,
      "offset_length": 0,
      "cut": "per_client",
      "lookback_crosses_boundary": true,
      "min_windows": 1,
      "cut_rows": [676, 773, 966]
    },
    "scaler": {
      "name": "Standard"
    },
    "view": {
      "name": "Offline",
      "drop_last": true
    },
    "store": {
      "name": "Parquet",
      "root": "datasets"
    }
  },
  "model": {
    "name": "TimesNet",
    "encoder_layers": 2,
    "k": 5,
    "d_model": 768,
    "d_ff": 768,
    "num_inception_kernels": 6,
    "dropout": 0.1,
    "calendar_channels": 4
  },
  "learner": {
    "name": "Gradient",
    "epochs": 1,
    "learning_rate": 0.0001,
    "optimizer": {
      "name": "Adam"
    }
  },
  "strategy": {
    "name": "Centralized",
    "iterations": 10
  },
  "evaluation": {
    "name": "Frozen",
    "loss": "MSE",
    "patience": 3,
    "metrics": {
      "validation": ["MSE"],
      "test": ["MSE"]
    }
  },
  "runtime": {
    "name": "Serial",
    "seed": 2021
  },
  "scheduler": {
    "name": "EpochHalving",
    "interval": 1
  },
  "sweep": {
    "data.split.output_length": [24, 36, 48, 60]
  }
}
